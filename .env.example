# ==========================================
# 1. BANCO DE DADOS NEON (PostgreSQL)
# ==========================================
# Obtenha no painel do Neon (https://console.neon.tech)
# Exemplo: postgresql://neondb_owner:senha@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# ==========================================
# 2. API DO ÉNÓIS (https://enois.ia.br/developers)
# ==========================================
# URL base da API do Énóis (em QA/testes use a base oficial de sandbox):
ENOIS_API_BASE_URL="https://enois-api-qa.b7cloud.tech/api"

# Origem cadastrada para o header X-Client-Origin (exigido pela API do Énóis)
# Em desenvolvimento local use http://localhost:3000. Em produção, use sua URL na Vercel/host.
ENOIS_CLIENT_ORIGIN="http://localhost:3000"

# (Opcional) Chave de API de integração, caso seu projeto receba uma credencial de parceiro/dev do Énóis:
ENOIS_API_KEY=""

# ==========================================
# 3. SEGURANÇA DE SESSÃO LOCAL (Next.js)
# ==========================================
# Chave aleatória para assinar o cookie seguro da sessão do usuário logado (ex: openssl rand -base64 32)
AUTH_SECRET="dobra-2048-session-secret-change-me"

